    "Policy": {
        "c0": "0",
        "c1": "6",
        "c2": "-1",
        "c3": "-1"
    },
    "Function": {
        "Cpuset": {
            "enable": "true",
            "top_app": "0-7",
            "foreground": "0-6",
            "restricted": "0-4",
            "system_background": "0-3",
            "background": "0-2"
        },
        "LaunchBoost": {
            "enable": "false",
            "boost_rate_limit_ms": "35",
            "BoostFreq": { "c0": "2100000", "c1": "2100000" }
        },
        "OfficialMode": { "enable": "false" },
        "Scheduler": {
            "enable": "true",
            "sched_energy_aware": "true",
            "sched_schedstats": "false",
            "sched_nr_migrate": "32",
            "sched_util_clamp_min": "0",
            "sched_util_clamp_max": "1024"
        },
        "GpuFreq": { "enable": "true" },
        "SceneDetect": {
            "enable": "true",
            "touch_enable": "false",
            "heavy_load_thd": "75",
            "idle_load_thd": "25",
            "heavy_confirm_count": "3",
            "heavy_max_duration_ms": "2500",
            "request_burst_slack_ms": "3000",
            "am_switch_duration_ms": "1200",
            "touch_duration_ms": "800",
            "load_sample_interval_ms": "2000",
            "screen_poll_interval_ms": "3000",
            "input_dev_max": "16"
        },
        "AppProfile": { "enable": "true" },
        "NetlinkScreen": { "enable": "true", "fallback_poll_ms": "3000" }
    },

    "package_blacklist": [
        "com.android.systemui",
        "com.android.launcher*",
        "com.miui.home",
        "com.huawei.android.launcher",
        "com.coloros.launcher",
